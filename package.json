{
  "name": "broadway-copilot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --poll --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch .git src/index.ts",
    "dev:nodemon": "nodemon --watch src --watch prompts --ext ts,txt --exec \"ts-node --transpile-only src/index.ts\"",
    "build": "tsc -p tsconfig.json && npm run build:scripts",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "start": "node dist/index.js",
    "graph": "ts-node-dev --transpile-only scripts/visualizeGraph.ts",
    "prune": "ts-prune",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "prisma:generate": "npx prisma@^6.15.0 generate",
    "prisma:migrate": "npx prisma@^6.15.0 migrate",
    "prisma:studio": "npx prisma@^6.15.0 studio",
    "eval:color-analysis": "node scripts/color-analysis-eval/run-eval.mjs",
    "clear-uploads": "node scripts/clear-uploads.mjs",
    "automation:sync-barcodes": "node dist/automation/scripts/barcodeSynchronizer.js",
    "automation:cron": "node dist/automation/cron/productTaggerCron.js",
    "automation:cron-barcodes": "node dist/automation/cron/barcodeSyncCron.js",
    "automation:run": "node dist/automation/scripts/runProductAutomation.js",
    "automation:validate": "node dist/automation/scripts/validateAutomation.js",
    "automation:retry-failed": "node dist/automation/scripts/retryFailedProducts.js",
    "automation:monitor": "node dist/automation/scripts/automationMonitor.js",
    "automation:health-check": "node dist/automation/scripts/healthCheck.js",
    "automation:run:dev": "ts-node --transpile-only src/automation/scripts/runProductAutomation.ts",
    "automation:validate:dev": "ts-node --transpile-only src/automation/scripts/validateAutomation.ts",
    "automation:sync-barcodes:dev": "ts-node --transpile-only src/automation/scripts/barcodeSynchronizer.ts",
    "automation:monitor:dev": "ts-node --transpile-only src/automation/scripts/automationMonitor.ts",
    "automation:health-check:dev": "ts-node --transpile-only src/automation/scripts/healthCheck.ts",
    "automation:seed-barcodes": "node dist/automation/scripts/seedBarcodesFromCsv.js",
    "automation:seed-barcodes:dev": "ts-node --transpile-only src/automation/scripts/seedBarcodesFromCsv.ts",
    "automation:purge-logs": "node dist/automation/scripts/purgeOldLogs.js",
    "automation:purge-logs:dev": "ts-node --transpile-only src/automation/scripts/purgeOldLogs.ts",
    "automation:vibe-check-reminder": "node dist/automation/cron/vibeCheckReminderCron.js",
    "automation:vibe-check-reminder:dev": "ts-node --transpile-only src/automation/cron/vibeCheckReminderCron.ts",
    "automation:bulk-sync": "node dist/automation/scripts/bulkCatalogSync.js",
    "automation:bulk-sync:dev": "ts-node --transpile-only src/automation/scripts/bulkCatalogSync.ts",
    "automation:patch-metadata:dev": "ts-node --transpile-only src/automation/scripts/patchProductMetadataFromCsv.ts",
    "automation:count-pending-embed:dev": "ts-node --transpile-only src/automation/scripts/countPendingEmbeddingProducts.ts",
    "automation:bulk-10k": "bash scripts/bulk-tag-embed-10k.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.90.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^6.15.0",
    "canvas": "^3.2.0",
    "colornames": "^1.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "groq-sdk": "^0.32.0",
    "openai": "^5.20.1",
    "papaparse": "^5.5.3",
    "pino": "^9.9.4",
    "prisma": "^6.15.0",
    "redis": "^5.8.2",
    "sharp": "^0.33.5",
    "zod": "^4.1.5",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.3.1",
    "@types/papaparse": "^5.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.2"
  }
}
