# Application
SERVER_URL=http://localhost:8080
NODE_ENV=development
PORT=8080
# Absolute uploads root (Docker: /app/uploads or /usr/src/app/uploads). Defaults to cwd/uploads.
# UPLOADS_ROOT=/app/uploads

# Databases
# Docker dev (docker-compose.bot.yml / stack / dashboard): use in-network Postgres URL, e.g.
#   DATABASE_URL=postgresql://postgres:postgres@db:5432/broadway?schema=public
# Compose overrides REDIS_URL inside containers to redis://redis:6379 (no auth). Your .env REDIS_URL can stay
# for running the app on the host (e.g. redis://localhost:6379 or a cloud URL); it is ignored in those stacks.
# Optional: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB (must match DATABASE_URL for bundled `db`).
# Optional host ports: POSTGRES_PUBLISH_PORT (default 5433 for bot/stack), REDIS_PUBLISH_PORT (127.0.0.1; default 6379 for bot/stack, 6380 for dashboard-only compose if you run both).
DATABASE_URL=postgresql://user:password@host:port/database?schema=public
REDIS_URL=redis://localhost:6379

# DB log retention (ServiceLog + ApiRequestLog). Cron: docker-compose.automation.yml service log-purge-cron.
# LOG_RETENTION_DAYS=7
# CRON_LOG_PURGE_SCHEDULE=15 3 * * *
# CRON_LOG_PURGE_ENABLED=true
# Optional: run purge once when the cron container starts (for testing)
# CRON_RUN_ON_START=true

# Product automation (tagging): SKU detail fetch. Default path uses sku-details-limited (no API key for public).
# BROADWAY_LIVE_API_BASE=https://api.broadwaylive.in
# Optional Bearer; leave unset if not required.
# BROADWAY_LIVE_API_KEY=
# BROADWAY_LIVE_SKU_DETAIL_SEGMENT=sku-details-limited

# Broadway user_service — session-scoped profile (name, stated gender/age) for /api/chat; no sync job required.
# Defaults to https://api.broadwaylive.in if unset.
# BROADWAY_USER_SERVICE_BASE_URL=https://api.broadwaylive.in
# Optional if the endpoint requires auth server-side.
# BROADWAY_USER_SERVICE_BEARER_TOKEN=
# BROADWAY_USER_SERVICE_TIMEOUT_MS=8000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_WEBHOOK=true
TWILIO_WAIT_FOR_STATUS=true
TWILIO_HTTP_TIMEOUT_MS=10000
TWILIO_SENT_TIMEOUT_MS=15000
TWILIO_DELIVERED_TIMEOUT_MS=60000
FEEDBACK_REQUEST_DELAY_MS=60000

# LLM Providers
# HTTP agent: OpenAI for chat + tools, intent, vision, and catalog embeddings (required for /api chat).
OPENAI_API_KEY=
# Main agent (default gpt-4o-mini). Intent + RecEng JSON (default gpt-4o-mini). Vision tools (default gpt-4o).
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_INTENT_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o
# AGENT_MAX_COMPLETION_TOKENS=1024
# Product automation tagging (vision + JSON). Default gpt-4o-mini.
# OPENAI_TAG_MODEL=gpt-4o-mini
# Listwise rerank for catalog vector + recommendation engine (gpt-4o-mini JSON ordering). Set to false to skip.
# OPENAI_RERANK_ENABLED=true
# OPENAI_RERANK_MODEL=gpt-4o-mini
# Optional: Groq for other graph paths if you use them.
# GROQ_API_KEY=

# Ngrok
NGROK_AUTHTOKEN=

# Google Cloud
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_FUNCTION_REGION=asia-south2
CLOUD_TASKS_REGION=asisa-south1
PROJECT_ID=broadway-chatbot


# Dashboard analytics UI proxies /analytics-api → this base URL (must expose /api/* e.g. GET /api/schema).
# docker-compose.dashboard.yml / docker-compose.bot.prod.yml set ANALYTICS_API_URL=http://analytics-api:8000 in-container.
# If you run the dashboard on the host (npm) while DB/analytics run in Docker, use http://localhost:8000
# and set ANALYTICS_API_HOST_PORT in compose (default 8000) so analytics-api publishes to the host.
ANALYTICS_API_URL=http://localhost:8000
# Optional: host port for analytics-api container (docker-compose.dashboard.yml and docker-compose.bot.prod.yml).
# ANALYTICS_API_HOST_PORT=8000

# analysis_agent source for building analytics-api (Python FastAPI). NOT used for vibe/chat event storage (those go to Postgres via the bot app).
# Default ../analysis_agent = sibling of this repo (e.g. ~/analysis_agent next to ~/broadway_copilot_newfork).
# On a server with only this repo cloned, copy or git-clone analysis_agent there, or into ./analysis_agent and set:
# ANALYSIS_AGENT_BUILD_CONTEXT=./analysis_agent
# ANALYSIS_AGENT_BUILD_CONTEXT=../analysis_agent
# Optional pre-built image (skip build): ANALYTICS_API_IMAGE=your-registry/broadway-analytics-api:tag

# Vibe check daily push (vibeCheckReminderCron). Base URL only — cron POSTs {COMMS_SERVICE_URL}/dispatch/push
# COMMS_SERVICE_URL=https://dev.broadwaylive.in/comms_service
# CRON_VIBE_CHECK_REMINDER_ENABLED=true
# VIBE_CHECK_REMINDER_INTERVAL_MS=60000
# CRON_RUN_ON_START=true

# Chat/vibe events are stored by the bot app in DATABASE_URL (AnalyticsEvent table). No ANALYTICS_API_URL needed for that.