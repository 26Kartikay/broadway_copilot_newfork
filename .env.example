# Application
# Public base (no trailing slash). Required for absolute links in chat (e.g. palette PDFs); native apps should resolve PDFs against this host.
SERVER_URL=http://localhost:8080
NODE_ENV=development
PORT=8080
# Absolute uploads root (Docker: /app/uploads or /usr/src/app/uploads). Defaults to cwd/uploads.
# UPLOADS_ROOT=/app/uploads

# Databases
DATABASE_URL=postgresql://user:password@host:port/database?schema=public
# Host-only dev (`npm run dev` on your machine): point at local Redis.
# Docker Compose (docker-compose.bot.yml / stack / dashboard): compose pins REDIS_URL to the
# bundled `redis` service — do NOT use host.docker.internal / 192.168.x.x here for those stacks.
REDIS_URL=redis://localhost:6379

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_WEBHOOK=true
TWILIO_WAIT_FOR_STATUS=true
TWILIO_HTTP_TIMEOUT_MS=10000
TWILIO_SENT_TIMEOUT_MS=15000
TWILIO_DELIVERED_TIMEOUT_MS=60000
FEEDBACK_REQUEST_DELAY_MS=60000

# LLM Providers
GROQ_API_KEY=
OPENAI_API_KEY=

# Ngrok
NGROK_AUTHTOKEN=

# Google Cloud
CLOUD_TASKS_SERVICE_ACCOUNT=
CLOUD_FUNCTION_REGION=asia-south2
CLOUD_TASKS_REGION=asisa-south1
PROJECT_ID=broadway-chatbot